HOST=0.0.0.0
PORT=8787
WEB_URL=http://127.0.0.1:8787
CORS_ORIGIN=http://127.0.0.1:8787
COOKIE_SECURE=false
ENABLE_DEV_AUTH=false

# Enable only after configuring ARTIFACT_CDN_BASE_URL and starting the artifacts profile.
ARTIFACTS_ENABLED=false
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=/var/lib/astrbot-market/artifacts
ARTIFACT_CDN_BASE_URL=
ARTIFACT_SUBMISSION_RPM=6

# Advanced review is opt-in and runs only in the artifact-worker/runtime-runner profiles.
ARTIFACT_ADVANCED_REVIEW_ENABLED=false
ARTIFACT_AUTO_APPROVE_ENABLED=false
ARTIFACT_RUNTIME_REVIEW_ENABLED=false
ARTIFACT_LLM_REVIEW_ENABLED=false
ARTIFACT_CLAMAV_ENABLED=false
ARTIFACT_YARA_ENABLED=false
ARTIFACT_DEPENDENCY_REVIEW_ENABLED=false

# Leave empty for the first launch if you want to initialize from /setup.
# In docker compose, use:
#   PostgreSQL host: postgres
#   PostgreSQL port: 5432
#   PostgreSQL database/user/password: market / market / market by default
#   Redis host: redis
#   Redis port: 6379
DATABASE_URL=
REDIS_URL=
