HOST=127.0.0.1
PORT=8787
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
WEB_URL=http://127.0.0.1:8787
SITE_NAME=AstrBot Community Plugins
SITE_ICON_URL=/logo.webp
SITE_SUBTITLE=全新社区插件市场
SITE_DESCRIPTION=发现、评价和提交 AstrBot 插件。
SITE_CONTACT_EMAIL=
SITE_DOCS_URL=https://docs.astrbot.app/dev/star/plugin-new.html
GITHUB_LOGIN_ENABLED=false
PUBLIC_LOGIN_ENABLED=true
LOGIN_AGREEMENT_ENABLED=false
LOGIN_AGREEMENT_TEXT=
SERVICE_TERMS_ENABLED=false
SERVICE_TERMS_TEXT=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Leave empty and configure this in `/settings`, unless you want an environment override.
GITHUB_CALLBACK_URL=
GITHUB_SCOPE=read:user user:email read:org
GITHUB_ADMIN_ORG=
GITHUB_API_TOKEN=
GITHUB_METADATA_SYNC_ENABLED=true
GITHUB_METADATA_SYNC_INTERVAL_SECONDS=3600

MARKET_SUBMISSIONS_ENABLED=true
MARKET_COMMENTS_ENABLED=true
MARKET_LIKES_ENABLED=true
PLUGIN_AUTO_APPROVE_ENABLED=false
MAX_PLUGIN_TAGS=8

# Immutable artifact review/CDN pipeline. Keep disabled until storage and CDN are configured.
ARTIFACTS_ENABLED=false
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=/var/lib/astrbot-market/artifacts
ARTIFACT_CDN_BASE_URL=
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=auto
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_QUARANTINE_BUCKET=
ARTIFACT_PUBLISHED_BUCKET=
ARTIFACT_MAX_UPLOAD_BYTES=33554432
ARTIFACT_MAX_UNPACKED_BYTES=134217728
ARTIFACT_MAX_FILE_BYTES=8388608
ARTIFACT_MAX_FILES=2000
ARTIFACT_MAX_COMPRESSION_RATIO=100
ARTIFACT_MAX_PATH_DEPTH=16
ARTIFACT_SUBMISSION_RPM=6
ARTIFACT_JOB_LEASE_SECONDS=300
ARTIFACT_WORKER_POLL_SECONDS=2
ARTIFACT_QUARANTINE_RETENTION_DAYS=30

# Advanced review runs in the external artifact worker. Model responses remain private.
ARTIFACT_ADVANCED_REVIEW_ENABLED=false
ARTIFACT_AUTO_APPROVE_ENABLED=false
ARTIFACT_LLM_REVIEW_ENABLED=false
ARTIFACT_LLM_CONFIG_REF=config:llm-default
ARTIFACT_LLM_PROVIDER=openai-compatible
ARTIFACT_LLM_MODEL=
ARTIFACT_LLM_ENDPOINT_URL=
ARTIFACT_LLM_API_KEY=

# Dedicated runtime-runner process only. Do not add these to the API or artifact-worker.
RUNTIME_RUNNER_DATABASE_URL=
RUNTIME_RUNNER_ID=
RUNTIME_RUNNER_EXECUTOR_BACKEND=rootless-docker
RUNTIME_RUNNER_RESULT_STORAGE_BACKEND=local
RUNTIME_RUNNER_RESULT_ROOT=/var/lib/astrbot-runtime-results
RUNTIME_RUNNER_DOCKER_BINARY=docker
# Production example: unix:///run/user/1000/docker.sock
RUNTIME_RUNNER_DOCKER_HOST=
RUNTIME_RUNNER_DOCKER_IMAGE_REPOSITORY=registry.example/astrbot-runtime-probe
RUNTIME_RUNNER_ARTIFACT_ROOT=/var/lib/astrbot-market/artifacts
RUNTIME_RUNNER_INSTALL_NETWORK=astrbot-runtime-install
RUNTIME_RUNNER_PACKAGE_INDEX_URL=https://pypi.org/simple
RUNTIME_RUNNER_INSTALL_PROXY_URL=http://astrbot-runtime-package-proxy:3128
RUNTIME_RUNNER_INSTALL_PROXY_CONTAINER=astrbot-runtime-package-proxy
RUNTIME_RUNNER_ALLOW_ROOTFUL_DEVELOPMENT=false
RUNTIME_RUNNER_SECCOMP_PROFILE=builtin
RUNTIME_RUNNER_APPARMOR_PROFILE=
RUNTIME_RUNNER_ORPHAN_TTL_SECONDS=7200

EMAIL_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
CLOUDFLARE_EMAIL_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_EMAIL_FROM=
EMAIL_DAILY_LIMIT=0
EMAIL_VERIFICATION_DAILY_LIMIT_PER_USER=5

# Leave empty on first launch and configure these from the web `/setup` page.
DATABASE_URL=
REDIS_URL=

SESSION_COOKIE_NAME=astrbot_market_session
OAUTH_STATE_COOKIE_NAME=astrbot_market_oauth_state
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=604800

ENABLE_DEV_AUTH=true
MARKET_API_KEYS=local:dev-market-key:market:read|market:write
