#!/usr/bin/env bash
# pre-commit (Python) pre-push hook (后端 ruff)
# 通过 pre-commit 的 hook-impl 正确解析 pre-push 的 stdin（被推送的引用），
# 进而只检查这些提交里的 Python 文件。仅依赖 PATH 上的 `pre-commit`。
if ! command -v pre-commit >/dev/null 2>&1; then
  echo "[pre-push] pre-commit 未安装，跳过后端 ruff 检查（安装：uv tool install pre-commit）" >&2
  exit 0
fi

ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-push)
HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

exec pre-commit "${ARGS[@]}"
