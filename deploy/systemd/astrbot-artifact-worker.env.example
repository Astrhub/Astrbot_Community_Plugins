WEB_URL=https://plugins.example.invalid
SITE_NAME=AstrBot Community Plugins
DATABASE_URL=postgresql://astrbot_worker:replace-me@127.0.0.1:5432/market
REDIS_URL=redis://127.0.0.1:6379/0

ARTIFACTS_ENABLED=false
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=/var/lib/astrbot-market/artifacts
ARTIFACT_CDN_BASE_URL=https://cdn.example.invalid/plugins
ARTIFACT_ADVANCED_REVIEW_ENABLED=false
ARTIFACT_AUTO_APPROVE_ENABLED=false
ARTIFACT_RUNTIME_REVIEW_ENABLED=false
ARTIFACT_RUNTIME_CONTAINER_IMAGE=
ARTIFACT_RUNTIME_RESULT_ROOT=/var/lib/astrbot-runtime-results

ARTIFACT_LLM_REVIEW_ENABLED=false
ARTIFACT_LLM_CONFIG_REF=config:llm-default
ARTIFACT_LLM_PROVIDER=openai-compatible
ARTIFACT_LLM_MODEL=
ARTIFACT_LLM_ENDPOINT_URL=
ARTIFACT_LLM_API_KEY=
ARTIFACT_CLAMAV_ENABLED=false
ARTIFACT_CLAMAV_CONFIG_REF=config:clamav-default
ARTIFACT_CLAMAV_HOST=
ARTIFACT_CLAMAV_PORT=3310
ARTIFACT_YARA_ENABLED=false
ARTIFACT_YARA_RULESET_VERSION=
ARTIFACT_YARA_RULESET_PATH=
ARTIFACT_YARA_RULESET_SOURCE=deployment
ARTIFACT_YARA_RULESET_ACTIVATED_AT=
ARTIFACT_DEPENDENCY_REVIEW_ENABLED=false
ARTIFACT_DEPENDENCY_CONFIG_REF=config:dependency-default
ARTIFACT_DEPENDENCY_ADVISORY_PATH=
ARTIFACT_DEPENDENCY_ADVISORY_URL=
ARTIFACT_DEPENDENCY_API_TOKEN=
EMAIL_PROVIDER=disabled
