HOST=0.0.0.0
PORT=8787
WEB_URL=https://plugins.example.invalid
CORS_ORIGIN=https://plugins.example.invalid
COOKIE_SECURE=true
ENABLE_DEV_AUTH=false

# The API receives quarantine uploads, but it never executes scanners or runtime containers.
ARTIFACTS_ENABLED=false
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_LOCAL_ROOT=/var/lib/astrbot-market/artifacts
ARTIFACT_CDN_BASE_URL=https://cdn.example.invalid/plugins

DATABASE_URL=postgresql://market:market@postgres:5432/market
REDIS_URL=redis://redis:6379/0
EMAIL_PROVIDER=disabled
