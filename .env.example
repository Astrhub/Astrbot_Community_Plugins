# Root Docker Compose configuration (copy to .env before running docker compose).
# Variables here are consumed by docker-compose.yml and docker-compose-local.yml.

# Exposed HTTP port on the host.
APP_PORT=8787

# Runtime site URL (used for SEO canonical/sitemap/robots and OAuth callbacks) and allowed CORS origin.
WEB_URL=http://127.0.0.1:8787
CORS_ORIGIN=http://127.0.0.1:8787
COOKIE_SECURE=false
ENABLE_DEV_AUTH=false

# Optional mirror registries during Docker build.
NPM_REGISTRY=
PYPI_INDEX_URL=

# PostgreSQL settings (used by docker-compose.yml only).
POSTGRES_DB=market
POSTGRES_USER=market
POSTGRES_PASSWORD=market

# Optional personal single-process overrides (used by docker-compose-local.yml).
# Leave CORE_ADMIN_USERNAME / CORE_ADMIN_PASSWORD empty to complete setup in /setup.
PLUGIN_AUTO_APPROVE_ENABLED=true
GITHUB_API_TOKEN=
CORE_ADMIN_USERNAME=
CORE_ADMIN_PASSWORD=
